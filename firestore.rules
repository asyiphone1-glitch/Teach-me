rules_version = '2';
// teach-me — נעילה לטלפונים מאושרים (18.11.2026, אושר ע״י ההורה). מחליף את "כל מי שנכנס" מ-12.11.
// כל טלפון (וגם השרת של התזכורות ו-yaya) נרשם ב-dev/{uid}. רק מי שאבא או אמא אישרו קורא וכותב.
// מדביקים את הקובץ הזה ב-Firebase: Firestore Database > Rules > Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function approved() {
      return request.auth != null
        && exists(/databases/$(database)/documents/dev/$(request.auth.uid))
        && get(/databases/$(database)/documents/dev/$(request.auth.uid)).data.ok == true;
    }

    // טלפון חדש רושם את עצמו כ"מחכה לאישור", ורואה רק את הרישום של עצמו
    match /dev/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      // 18.11.2026 לילה (בדיקת אבטחה, אושר): זר לא יכול להירשם בשם "שרת התזכורות" או בשם ארוך ומטעה.
      // מותר רק: טלפון של ילדה / של הורים / של yaya, עם שם מכשיר קצר. השרתים נכנסים עם מפתח השירות (FIREBASE_SA).
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ok', 'at', 'kind', 'who'])
        && request.resource.data.ok == false
        && request.resource.data.who in ['aviv', 'roni', 'hili', 'ziv', 'parent', 'yaya']
        && (!('kind' in request.resource.data) || (request.resource.data.kind is string && request.resource.data.kind.size() <= 12))
        && (!('at' in request.resource.data) || request.resource.data.at is number);
    }

    // כל השאר (כולל אישור טלפונים): רק טלפון מאושר
    match /{document=**} {
      allow read, write: if approved();
    }
  }
}
