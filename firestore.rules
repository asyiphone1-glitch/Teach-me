rules_version = '2';
// teach-me — חוקים קבועים (12.11.2026). במקום "מצב בדיקה" שפג ב-8.12.
// קריאה וכתיבה רק למי שנכנס דרך האפליקציה (כניסה אנונימית של Firebase). בלי תאריך תפוגה.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
